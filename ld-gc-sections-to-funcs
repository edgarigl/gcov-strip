#!/usr/bin/env python3
"""Convert linker `--print-gc-sections` output into removals for gcov-strip."""
# pylint: disable=invalid-name,too-many-lines
#
# Convert linker `--print-gc-sections` output into a list of function names
# whose coverage notes should be removed from `.gcno` files.
#
# The basic flow is:
# - scan linker stderr for discarded `.text.<function>` sections
# - normalize GCC clone suffixes so linker, DWARF, and gcov names line up
# - optionally inspect DWARF to find inline-only callees whose out-of-line body
#   disappeared once all callers were garbage-collected
# - write the final function list to stdout or a config file consumed by
#   `gcov-strip`
#
# The DWARF approach is intentionally conservative. It does not try to rebuild
# full linker provenance. Instead it asks a narrower question:
# - which inlined callees are described only as inline expansions in DWARF?
# - which callers contain those inline expansions?
# - can both sides be mapped back to a concrete leaf object with a gcno file?
# If the callee has no concrete code range of its own and every observed caller
# was already removed by the linker, the callee becomes a candidate for gcno
# stripping as well. Missing or ambiguous object provenance leaves the entry in
# review-only form instead of widening the removal scope.
#
# Copyright (c) 2026 Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

import argparse
import os
import re
import subprocess
import sys
from collections import defaultdict
from dataclasses import dataclass
from itertools import batched
from typing import DefaultDict, Dict, Iterable, List, NamedTuple, Optional, Set, Tuple

FuncKey = Tuple[str, Optional[str]]
SymbolIndex = DefaultDict[str, Set[str]]

# BodyIndex is onceptually:
# {
#     "lib.o": {
#         "helper": {"helper", "helper.constprop.0"},
#     },
# }
#
# The outer key is the object file, the inner key is the normalized gcov
# function identity, and the set contains every raw emitted body name that
# contributes to that identity. This lets the resolver skip gcno stripping
# when a removed clone still shares coverage with another live body.
BodyIndex = DefaultDict[str, DefaultDict[str, Set[str]]]


@dataclass
# pylint: disable=too-many-instance-attributes
class Die:
    """One parsed DWARF DIE entry from `readelf --debug-dump=info`."""

    tag: str                            # DIE tag, e.g. inlined_subroutine
    name: Optional[str] = None          # DW_AT_name source-level name
    linkage_name: Optional[str] = None  # linker-visible symbol name
    origin: Optional[int] = None        # referenced inline/cloned origin
    declaration: Optional[int] = None   # referenced declaration DIE
    parent: Optional[int] = None        # parent DIE offset in this CU
    has_code: bool = False              # has low_pc or ranges
    cu_offset: Optional[int] = None     # owning compile-unit offset
    cu_name: Optional[str] = None       # compile-unit source path
    cu_comp_dir: Optional[str] = None   # compile-unit working dir
    cu_language: Optional[str] = None   # compile-unit language string
    dwarf_object: Optional[str] = None  # scanned leaf-object path


@dataclass(frozen=True)
class RemovalEntry:
    """One removed text body plus the normalized gcov identity it maps to."""

    name: str
    obj_path: Optional[str]
    symbol_name: str
    # `.text.unlikely.foo` in linker GC output usually corresponds to the
    # emitted cold split body `foo.cold` in the leaf object.
    is_unlikely: bool = False


DieMap = Dict[int, Die]


class DwarfResolutionState(NamedTuple):
    """Final-ELF DWARF state used while resolving removed functions."""

    final_defined_functions: Set[FuncKey]
    assembly_defined_names: Set[str]


class DwarfParseResult(NamedTuple):
    """Collected DWARF data used by the removal and inline-only passes."""

    inlined_callers: Dict[FuncKey, Set[FuncKey]]
    defined_functions: Set[FuncKey]
    final_defined_functions: Set[FuncKey]
    assembly_defined_names: Set[str]


@dataclass
class ResolutionOutput:
    """Mutable output state while resolving linker removals."""

    resolved_lines: List[str]
    warnings: List[str]
    review_lines: List[str]
    seen_lines: Set[str]
    origin_removed_objects: DefaultDict[str, Set[str]]


@dataclass
class LeafSelectionPolicy:
    """Hints used while resolving one same-name leaf-object choice."""

    surviving_symbols: SymbolIndex
    removed_objects: Set[str]
    preferred_removed_objects: Set[str]
    allow_surviving_symbols: bool = True


REMOVAL_RE = re.compile(
    r"removing unused section '([^']+)' in file '([^']+)'", re.IGNORECASE
)
ARCHIVE_MEMBER_RE = re.compile(r"^(?P<archive>\S+\.a)\((?P<member>[^)]+)\)")
CLONE_SUFFIXES = (
    "constprop",
    "isra",
    "part",
    "clone",
    "cold",
)
CLONE_RE = re.compile(
    rf"^(?P<base>.+?)\.(?:{'|'.join(CLONE_SUFFIXES)})(?:\.\d+)?$"
)
DIE_RE = re.compile(
    r"^\s*<(?P<depth>\d+)><(?P<offset>[0-9a-fA-F]+)>: Abbrev Number: \d+ \((?P<tag>[^)]+)\)"
)
# `DW_AT_name` is the generic source-level name field. Depending on the DIE, it
# may describe a compile unit's source file or a function's unmangled name.
DWARF_NAME_RE = re.compile(r"DW_AT_name\s*:\s*(?P<value>.+)")
# `DW_AT_comp_dir` gives the compilation directory for a compile unit so a
# relative `DW_AT_name` source path can be turned back into a likely object/gcno
# location.
DWARF_COMP_DIR_RE = re.compile(r"DW_AT_comp_dir\s*:\s*(?P<value>.+)")
# `DW_AT_language` is the older language attribute, while newer DWARF can emit
# `DW_AT_language_name`. Accept both named forms so assembler compile units are
# still recognized when newer binutils start using the newer attribute spelling.
DWARF_LANGUAGE_RE = re.compile(r"DW_AT_language(?:_name)?\s*:\s*(?P<value>.+)")
# `DW_AT_linkage_name` / `DW_AT_MIPS_linkage_name` carry the linker-visible
# symbol name when the plain source-level `DW_AT_name` is not unique enough.
DWARF_LINKAGE_RE = re.compile(
    r"DW_AT_(?:linkage_name|MIPS_linkage_name)\s*:\s*(?P<value>.+)"
)
# `DW_AT_abstract_origin` points from an inline expansion or cloned concrete
# DIE back to the abstract DIE that owns the callee identity.
DWARF_ABSTRACT_ORIGIN_RE = re.compile(
    r"DW_AT_abstract_origin\s*:\s*(?:\([^)]*\)\s*)?<0x(?P<offset>[0-9a-fA-F]+)>"
)
# `DW_AT_specification` points from a concrete definition to a separate
# declaration DIE that may carry the canonical source-level name.
DWARF_SPECIFICATION_RE = re.compile(
    r"DW_AT_specification\s*:\s*(?:\([^)]*\)\s*)?<0x(?P<offset>[0-9a-fA-F]+)>"
)
# `DW_AT_low_pc` and `DW_AT_ranges` are the simplest cross-toolchain signals
# that a subprogram still has concrete machine code in the final DWARF view.
# If either is present, we usually treat the function as still having an
# out-of-line body and therefore not safe to auto-remove as "inline-only".
#
# Binutils clears debug relocations that point into discarded sections during
# final links. In practice that can leave a dead subprogram DIE behind with
# `DW_AT_low_pc: 0`. We special-case that below for final non-`.o` inputs.
DWARF_LOW_PC_RE = re.compile(r"DW_AT_low_pc\s*:\s*(?P<value>.+)")
DWARF_RANGES_RE = re.compile(r"DW_AT_ranges\b")
NM_LINE_RE = re.compile(
    r"^(?:[0-9A-Fa-f]+\s+)?(?P<type>[A-Za-z])\s+(?P<name>\S+)$"
)
NM_BATCH_SIZE = 64
TEXT_SECTION_PREFIXES = ("unlikely", "startup", "hot", "exit")
# GCC-generated gcov constructor/destructor wrappers. These do not have
# their own gcno function records, so ignore them when translating linker
# removals into gcno stripping candidates.
# https://gcc.gnu.org/onlinedocs/gcc/Freestanding-Environments.html
GENERATED_GCOV_WRAPPER_RE = re.compile(r"^_sub_[ID]_\d+_\d+$")


def extract_functions(
    lines: Iterable[str],
    echo_stderr: bool,
) -> List[RemovalEntry]:
    """Extract unique removed text bodies from linker output."""
    functions: List[RemovalEntry] = []
    seen: Set[RemovalEntry] = set()
    for line in lines:
        if echo_stderr:
            sys.stderr.write(line)

        match = REMOVAL_RE.search(line)
        if not match:
            continue

        section, obj_path = match.groups()
        symbol_name = parse_text_section_name(section)
        if symbol_name is None:
            continue
        if GENERATED_GCOV_WRAPPER_RE.match(symbol_name):
            continue
        entry = RemovalEntry(
            normalize_name(symbol_name),
            normalize_object_path(obj_path),
            symbol_name,
            section.startswith(".text.unlikely."),
        )
        if entry not in seen:
            seen.add(entry)
            functions.append(entry)
    return functions


def parse_text_section_name(
    section: str,
) -> Optional[str]:
    """Parse `.text` section names conservatively into raw symbol names."""
    if not section.startswith(".text."):
        return None

    parts = clean_name(section[len(".text.") :]).split(".")
    while len(parts) > 1 and parts[0] in TEXT_SECTION_PREFIXES:
        parts = parts[1:]

    name = ".".join(parts)
    if not name:
        return None
    if "." in normalize_name(name):
        return None
    return clean_name(name)


def normalize_object_path(path: str) -> str:
    """Normalize an object path into a stable key for gcno matching."""
    normalized = os.path.normpath(path)
    if os.path.isabs(normalized):
        try:
            return os.path.relpath(normalized, os.getcwd())
        except ValueError:
            return normalized
    return normalized


def matching_gcno_path(path: str) -> Optional[str]:
    """Return one existing gcno path for an object, or `None` if none match."""
    normalized = normalize_object_path(path)
    if not normalized.endswith(".o"):
        raise ValueError(f"expected .o path, got {path!r}")

    candidates = {normalized}
    if not os.path.isabs(normalized):
        candidates.add(os.path.abspath(normalized))

    for candidate in candidates:
        gcno_path = os.path.splitext(candidate)[0] + ".gcno"
        if os.path.exists(gcno_path):
            return gcno_path
    return None


def object_from_source_path(source_name: str, comp_dir: Optional[str]) -> Optional[str]:
    """Map a DWARF compile-unit source path back to a likely leaf object."""
    candidates: List[str] = []
    if os.path.isabs(source_name):
        candidates.append(source_name)
    elif comp_dir:
        candidates.append(os.path.join(comp_dir, source_name))
    candidates.append(source_name)

    seen: Set[str] = set()
    for candidate in candidates:
        base, _ = os.path.splitext(candidate)
        obj_candidate = normalize_object_path(base + ".o")
        if obj_candidate in seen:
            continue
        seen.add(obj_candidate)
        if matching_gcno_path(obj_candidate):
            return obj_candidate
    return None


def iter_object_files(root: str) -> Iterable[str]:
    """Yield object files found under `root`."""
    for base, _, files in os.walk(root):
        for filename in files:
            if filename.endswith(".o"):
                yield os.path.join(base, filename)


def iter_nm_symbols(output: str) -> Iterable[Tuple[str, str, str]]:
    """Yield `(object_path, symbol_type, symbol_name)` from `nm -A` output."""
    for line in output.splitlines():
        if ":" not in line:
            continue

        obj_path, record = line.split(":", 1)
        match = NM_LINE_RE.match(record.strip())
        if not match:
            continue

        yield (
            normalize_object_path(obj_path),
            match.group("type"),
            match.group("name"),
        )


def build_symbol_indexes(
    root: str,
    interesting_names: Set[str],
) -> Tuple[SymbolIndex, SymbolIndex, BodyIndex]:
    """Build object indexes for normalized names and their raw emitted bodies."""
    gcno_backed: SymbolIndex = defaultdict(set)
    all_leaf: SymbolIndex = defaultdict(set)
    bodies_by_object: BodyIndex = defaultdict(lambda: defaultdict(set))

    object_paths = list(iter_object_files(root))
    has_gcno_by_object = {
        normalize_object_path(obj_path): matching_gcno_path(
            normalize_object_path(obj_path)
        )
        for obj_path in object_paths
    }
    seen_by_object: DefaultDict[str, Set[str]] = defaultdict(set)

    def index_symbol(rel_path: str, symbol_name: str) -> None:
        """Record one emitted symbol in the normalized object indexes."""
        raw_name = clean_name(symbol_name)
        if raw_name.startswith("."):
            return

        name = normalize_name(raw_name)
        if name not in interesting_names or name in seen_by_object[rel_path]:
            if name in interesting_names:
                bodies_by_object[rel_path][name].add(raw_name)
            return

        all_leaf[name].add(rel_path)
        if has_gcno_by_object.get(rel_path, False):
            gcno_backed[name].add(rel_path)
        seen_by_object[rel_path].add(name)
        bodies_by_object[rel_path][name].add(raw_name)

    for batch in batched(object_paths, NM_BATCH_SIZE):
        try:
            output = subprocess.check_output(
                ["nm", "-A", "--defined-only", *batch],
                text=True,
                errors="replace",
                stderr=subprocess.DEVNULL,
            )
        except (FileNotFoundError, subprocess.CalledProcessError) as exc:
            raise RuntimeError(f"nm failed for batch starting with {batch[0]}") from exc

        for rel_path, symbol_type, symbol_name in iter_nm_symbols(output):
            if symbol_type not in {"T", "t", "W", "w"}:
                continue
            index_symbol(rel_path, symbol_name)
    return gcno_backed, all_leaf, bodies_by_object


def build_removed_object_set(removed_entries: List[RemovalEntry]) -> Set[str]:
    """Return leaf objects that already appear directly in linker removals."""
    removed_objects: Set[str] = set()
    for entry in removed_entries:
        obj_path = entry.obj_path
        if obj_path is None:
            continue
        if matching_gcno_path(obj_path):
            removed_objects.add(obj_path)
    return removed_objects


def parse_linker_map_included_members(path: str) -> Set[Tuple[str, str]]:
    """Return `(archive, member)` pairs included according to one linker map."""
    included: Set[Tuple[str, str]] = set()
    in_archive_block = False
    saw_archive_entry = False
    map_dir = os.path.dirname(os.path.abspath(path))

    with open(path, "r", encoding="utf-8", errors="replace") as handle:
        for line in handle:
            stripped = line.strip()

            if not in_archive_block:
                if stripped == "Archive member included to satisfy reference by file (symbol)":
                    in_archive_block = True
                continue

            if not stripped:
                if saw_archive_entry:
                    break
                continue

            match = ARCHIVE_MEMBER_RE.match(stripped)
            if not match:
                continue

            archive = normalize_object_path(
                os.path.join(map_dir, match.group("archive"))
            )
            member = match.group("member")
            included.add((archive, member))
            saw_archive_entry = True

    return included


def iter_archive_members(archive_path: str) -> Iterable[str]:
    """Yield member names listed by `ar t` for one archive."""
    try:
        output = subprocess.check_output(
            ["ar", "t", archive_path],
            text=True,
            errors="replace",
            stderr=subprocess.DEVNULL,
        )
    except (FileNotFoundError, subprocess.CalledProcessError) as exc:
        raise RuntimeError(f"ar failed for archive {archive_path}") from exc

    for line in output.splitlines():
        member = line.strip()
        if member:
            yield member


def iter_archive_paths(root: str) -> Iterable[str]:
    """Yield static archives found under `root`."""
    for base, _, files in os.walk(root):
        for filename in files:
            if filename.endswith(".a"):
                yield os.path.join(base, filename)

def filter_project_archives(
    included: Set[Tuple[str, str]],
    root: str,
) -> Set[Tuple[str, str]]:
    """Keep only linker-map archive entries that live under the project tree."""
    project_prefix = os.path.abspath(root) + os.sep
    filtered = set()
    for archive_path, member in included:
        absolute_archive_path = os.path.abspath(archive_path)
        if absolute_archive_path.startswith(project_prefix):
            filtered.add((archive_path, member))
    return filtered

def collect_archive_paths(root: str) -> Set[str]:
    """Return normalized archive paths found under `root`."""
    archive_paths = set()
    for path in iter_archive_paths(root):
        archive_paths.add(normalize_object_path(path))
    return archive_paths


def find_missing_archives(
    included: Set[Tuple[str, str]],
    archive_paths: Set[str],
) -> List[str]:
    """Return sorted archive paths mentioned by the map but missing on disk."""
    missing_archives = []
    for archive_path, _member in included:
        if archive_path in archive_paths:
            continue
        missing_archives.append(archive_path)
    missing_archives.sort()
    return missing_archives


def resolve_linker_map_gcno_removals(
    root: str,
    linker_map: str,
) -> Tuple[List[str], List[str]]:
    """Return `object:*` lines plus warnings for map archives not found on disk."""
    included = parse_linker_map_included_members(linker_map)
    included = filter_project_archives(included, root)

    lines: List[str] = []
    seen: Set[str] = set()
    warnings: List[str] = []

    archive_paths = collect_archive_paths(root)
    missing_archives = find_missing_archives(included, archive_paths)

    for archive_path in missing_archives:
        warnings.append(
            f"linker map archive {archive_path} could not be found on disk"
        )

    for archive_path in iter_archive_paths(root):
        archive_key = normalize_object_path(archive_path)
        archive_dir = os.path.dirname(archive_key)
        for member in iter_archive_members(archive_path):
            if not member.endswith(".o"):
                continue
            if (archive_key, member) in included:
                continue

            obj_path = normalize_object_path(os.path.join(archive_dir, member))
            if not matching_gcno_path(obj_path):
                continue

            line = f"{obj_path}:*"
            if line not in seen:
                seen.add(line)
                lines.append(line)

    return lines, warnings


def build_surviving_symbol_index(defined_functions: Set[FuncKey]) -> SymbolIndex:
    """Index final-DWARF `function -> surviving objects` relationships."""
    surviving: SymbolIndex = defaultdict(set)
    for name, obj_path in defined_functions:
        if obj_path:
            surviving[name].add(obj_path)
    return surviving


def pick_leaf_object(
    name: str,
    leaf_objects: List[str],
    policy: LeafSelectionPolicy,
) -> Tuple[Optional[List[str]], List[str]]:
    """Choose removed leaf objects and report the candidates considered."""
    if len(leaf_objects) == 1:
        return leaf_objects, leaf_objects

    touched_objects = [
        path for path in leaf_objects
        if path in policy.preferred_removed_objects
    ]
    if touched_objects:
        return touched_objects, touched_objects

    touched_objects = [
        path for path in leaf_objects if path in policy.removed_objects
    ]
    if len(touched_objects) == 1:
        return touched_objects, touched_objects

    if not policy.allow_surviving_symbols:
        return None, touched_objects or leaf_objects

    # If final-ELF DWARF says which same-name leaf object survived, prefer the
    # remaining candidate. This is stronger than a name scan because it comes
    # from the actual linked image instead of just "who defines this name".
    surviving_objects = sorted(
        path for path in leaf_objects
        if path in policy.surviving_symbols.get(name, set())
    )
    removed_candidates = [
        path for path in leaf_objects if path not in set(surviving_objects)
    ]
    if surviving_objects and len(removed_candidates) == 1:
        return removed_candidates, removed_candidates

    return None, touched_objects or leaf_objects


class RemovalResolver:
    """Resolve removed functions into object-qualified config lines."""

    def __init__(
        self,
        removed_entries: List[RemovalEntry],
        strict: bool,
        dwarf_state: Optional[DwarfResolutionState] = None,
    ):
        """Build the indexes needed to scope removals to leaf objects."""
        dwarf_state = dwarf_state or DwarfResolutionState(set(), set())
        self.strict = strict
        (
            self.gcno_symbol_index,
            self.leaf_symbol_index,
            self.object_bodies,
        ) = build_symbol_indexes(
            os.getcwd(),
            {entry.name for entry in removed_entries},
        )
        self.removed_entries = removed_entries
        self.direct_removed_objects = build_removed_object_set(removed_entries)
        self.surviving_symbols = build_surviving_symbol_index(
            dwarf_state.final_defined_functions
        )
        self.defined_names = {
            name for name, _ in dwarf_state.final_defined_functions
        }
        self.assembly_defined_names = dwarf_state.assembly_defined_names

    def format_review_block(
        self,
        heading: str,
        detail_lines: List[str],
        name: str,
    ) -> List[str]:
        """Build one commented review/info block with a trailing blank line."""
        return [heading, *detail_lines, f"# {name}", ""]

    def select_leaf_objects(
        self,
        entry: RemovalEntry,
        preferred_removed_objects: Optional[Set[str]] = None,
        allow_surviving_symbols: bool = True,
    ) -> Tuple[Optional[List[str]], List[str]]:
        """Choose leaf objects for one removal entry."""
        name = entry.name
        obj_path = entry.obj_path
        if obj_path and matching_gcno_path(obj_path):
            return [obj_path], [obj_path]

        leaf_objects = sorted(self.gcno_symbol_index.get(name, set()))
        preferred_removed_objects = preferred_removed_objects or set()
        if preferred_removed_objects:
            filtered_preferred: Set[str] = set()
            for path in preferred_removed_objects:
                defined = self.object_bodies.get(path, {}).get(name, set())
                if not defined:
                    filtered_preferred.add(path)
                    continue
                if entry.symbol_name in defined:
                    filtered_preferred.add(path)
                    continue
                if entry.is_unlikely:
                    cold_name = f"{entry.symbol_name}.cold"
                    if cold_name in defined:
                        filtered_preferred.add(path)
            preferred_removed_objects = filtered_preferred

        policy = LeafSelectionPolicy(
            self.surviving_symbols,
            self.direct_removed_objects,
            preferred_removed_objects,
            allow_surviving_symbols,
        )
        chosen_objects, candidate_objects = pick_leaf_object(
            name,
            leaf_objects,
            policy,
        )
        return chosen_objects, candidate_objects

    def resolve_selected_objects(
        self,
        entry: RemovalEntry,
        obj_paths: List[str],
    ) -> Tuple[List[str], List[str], List[str]]:
        """Resolve one removal entry for a selected set of leaf objects."""
        lines: List[str] = []
        warnings: List[str] = []
        review_lines: List[str] = []
        seen_lines: Set[str] = set()

        for obj_path in obj_paths:
            obj_lines, obj_warnings, obj_review_lines = self.resolve_gcno_entry(
                entry,
                obj_path,
            )
            warnings.extend(obj_warnings)
            review_lines.extend(obj_review_lines)
            for line in obj_lines:
                if line not in seen_lines:
                    seen_lines.add(line)
                    lines.append(line)

        return lines, warnings, review_lines

    def ambiguous_result(
        self,
        name: str,
        obj_path: Optional[str],
        candidate_objects: List[str],
    ) -> Tuple[List[str], List[str], List[str]]:
        """Return warnings and optional review lines for one ambiguous removal."""
        joined = ", ".join(candidate_objects)
        warnings = [
            f"Ambiguous removal for {name}: {obj_path or '<unknown object>'} "
            f"matches multiple leaf objects ({joined})"
        ]
        if self.strict:
            return [], warnings, []
        review_lines = self.format_review_block(
            "# REVIEW ambiguous removal for "
            f"{name} from {obj_path or '<unknown object>'}",
            [f"# candidates: {joined}"],
            name,
        )
        return [], warnings, review_lines

    def unresolved_result(
        self,
        name: str,
        obj_path: Optional[str],
    ) -> Tuple[List[str], List[str], List[str]]:
        """Return warnings and optional review lines for one unresolved removal."""
        uncovered_objects = sorted(
            path
            for path in self.leaf_symbol_index.get(name, set())
            if not matching_gcno_path(path)
        )
        if uncovered_objects and (
            name not in self.defined_names or name in self.assembly_defined_names
        ):
            return self.uncovered_result(name, obj_path, uncovered_objects)

        warnings = [
            f"Could not resolve {name} from {obj_path or '<unknown object>'} "
            "to a leaf object"
        ]
        if self.strict:
            return [], warnings, []
        review_lines = self.format_review_block(
            "# REVIEW unresolved removal for "
            f"{name} from {obj_path or '<unknown object>'}",
            ["# candidates: none"],
            name,
        )
        return [], warnings, review_lines

    def uncovered_result(
        self,
        name: str,
        obj_path: Optional[str],
        uncovered_objects: List[str],
    ) -> Tuple[List[str], List[str], List[str]]:
        """Return an info-style review block for likely non-covered code."""
        joined = ", ".join(uncovered_objects)
        warnings = [
            f"{name} from {obj_path or '<unknown object>'} only matches leaf "
            f"objects without gcno or DWARF function provenance ({joined})"
        ]
        if self.strict:
            return [], warnings, []
        review_lines = self.format_review_block(
            "# INFO likely assembly/no-coverage removal for "
            f"{name} from {obj_path or '<unknown object>'}",
            [
                "# reason: no gcno coverage",
                f"# candidates: {joined}",
            ],
            name,
        )
        return [], warnings, review_lines

    def resolve_gcno_entry(
        self,
        entry: RemovalEntry,
        obj_path: str,
    ) -> Tuple[List[str], List[str], List[str]]:
        """Resolve one removal for an object that already has a matching gcno."""
        name = entry.name
        defined_bodies = self.object_bodies.get(obj_path, {}).get(name, set())
        if not defined_bodies:
            return [f"{obj_path}:{name}"], [], []

        removed_bodies = self._collect_removed_bodies(entry, defined_bodies)
        matched_removed = defined_bodies & removed_bodies

        if len(defined_bodies) == 1:
            return self._resolve_single_body(entry, obj_path, defined_bodies, matched_removed)

        if defined_bodies.issubset(removed_bodies):
            return [f"{obj_path}:{name}"], [], []

        return self._resolve_multi_body(entry, obj_path, defined_bodies, removed_bodies)

    def _collect_removed_bodies(
        self,
        entry: RemovalEntry,
        defined_bodies: Set[str],
    ) -> Set[str]:
        """Collect removed body names that match the defined bodies for a leaf object."""
        removed_bodies: Set[str] = set()
        origin_obj_path = entry.obj_path
        for sibling in self.removed_entries:
            if sibling.obj_path != origin_obj_path or sibling.name != entry.name:
                continue

            body_name = sibling.symbol_name
            if sibling.is_unlikely:
                cold_name = f"{body_name}.cold"
                if cold_name in defined_bodies:
                    removed_bodies.add(cold_name)
                    continue

            if body_name in defined_bodies:
                removed_bodies.add(body_name)
        return removed_bodies

    def _resolve_single_body(
        self,
        entry: RemovalEntry,
        obj_path: str,
        defined_bodies: Set[str],
        matched_removed: Set[str],
    ) -> Tuple[List[str], List[str], List[str]]:
        """Resolve a single-body object removal, warning if raw names mismatch."""
        if matched_removed:
            return [f"{obj_path}:{entry.name}"], [], []

        only_body = next(iter(defined_bodies))
        warnings = [
            f"Skipping gcno removal for {entry.name} from {obj_path}: "
            f"removed raw body {entry.symbol_name} "
            f"(origin {entry.obj_path or '<unknown object>'}) "
            f"does not match emitted body {only_body}"
        ]
        if self.strict:
            return [], warnings, []
        return [], warnings, []

    def _resolve_multi_body(
        self,
        entry: RemovalEntry,
        obj_path: str,
        defined_bodies: Set[str],
        removed_bodies: Set[str],
    ) -> Tuple[List[str], List[str], List[str]]:
        """Handle removal resolution when multiple bodies exist in the leaf object."""
        remaining_bodies = sorted(defined_bodies - removed_bodies)
        removed_body_list = sorted(removed_bodies) or ["unknown"]
        warnings = [
            f"Skipping gcno removal for {entry.name} from {obj_path}: "
            f"removed bodies ({', '.join(removed_body_list)}) still share "
            f"coverage with live bodies ({', '.join(remaining_bodies)})"
        ]
        if self.strict:
            return [], warnings, []
        review_lines = self.format_review_block(
            "# INFO skipped clone-only removal for "
            f"{entry.name} from {obj_path}",
            [
                "# reason: live out-of-line body still present",
                f"# removed bodies: {', '.join(removed_body_list)}",
                f"# remaining bodies: {', '.join(remaining_bodies)}",
            ],
            entry.name,
        )
        return [], warnings, review_lines


def preferred_removed_objects_for_entry(
    origin_removed_objects: DefaultDict[str, Set[str]],
    entry: RemovalEntry,
) -> Set[str]:
    """Return leaf objects already resolved from the same linker-origin object."""
    obj_path = entry.obj_path
    if obj_path is None:
        return set()
    return origin_removed_objects.get(obj_path, set())


def append_resolution_results(
    state: ResolutionOutput,
    candidate_lines: List[str],
    entry_warnings: List[str],
    entry_review_lines: List[str],
) -> None:
    """Append one entry's resolution results to the final output lists."""
    state.warnings.extend(entry_warnings)
    state.review_lines.extend(entry_review_lines)
    for line in candidate_lines:
        if line not in state.seen_lines:
            state.seen_lines.add(line)
            state.resolved_lines.append(line)


def finish_pending_entries(
    resolver: RemovalResolver,
    pending_entries: List[RemovalEntry],
    state: ResolutionOutput,
) -> None:
    """Finish unresolved entries once no more staged progress is possible."""
    for entry in pending_entries:
        preferred_removed_objects = preferred_removed_objects_for_entry(
            state.origin_removed_objects,
            entry,
        )
        chosen_objects, candidate_objects = resolver.select_leaf_objects(
            entry,
            preferred_removed_objects,
            True,
        )
        if chosen_objects is not None:
            candidate_lines, entry_warnings, entry_review_lines = (
                resolver.resolve_selected_objects(entry, chosen_objects)
            )
        elif candidate_objects:
            candidate_lines, entry_warnings, entry_review_lines = (
                resolver.ambiguous_result(
                    entry.name,
                    entry.obj_path,
                    candidate_objects,
                )
            )
        else:
            candidate_lines, entry_warnings, entry_review_lines = (
                resolver.unresolved_result(
                    entry.name,
                    entry.obj_path,
                )
            )

        append_resolution_results(
            state,
            candidate_lines,
            entry_warnings,
            entry_review_lines,
        )


def advance_pending_entries(
    resolver: RemovalResolver,
    pending_entries: List[RemovalEntry],
    state: ResolutionOutput,
) -> Tuple[List[RemovalEntry], bool]:
    """Resolve one staged pass and return `(next_pending, made_progress)`."""
    next_pending: List[RemovalEntry] = []
    made_progress = False

    for entry in pending_entries:
        preferred_removed_objects = preferred_removed_objects_for_entry(
            state.origin_removed_objects,
            entry,
        )
        chosen_objects, _candidate_objects = resolver.select_leaf_objects(
            entry,
            preferred_removed_objects,
            False,
        )
        if chosen_objects is None:
            next_pending.append(entry)
            continue

        candidate_lines, entry_warnings, entry_review_lines = (
            resolver.resolve_selected_objects(entry, chosen_objects)
        )
        # Remember leaf objects resolved from this linker-origin object so later
        # same-name removals from the same prelink.o can reuse that provenance.
        for obj_path in chosen_objects:
            if entry.obj_path:
                state.origin_removed_objects[entry.obj_path].add(obj_path)
        append_resolution_results(
            state,
            candidate_lines,
            entry_warnings,
            entry_review_lines,
        )
        made_progress = True

    return next_pending, made_progress


def resolve_removed_entries(
    removed_entries: List[RemovalEntry],
    strict: bool,
    dwarf_state: Optional[DwarfResolutionState] = None,
) -> Tuple[List[str], List[str], List[str]]:
    """Turn removed entries into active config lines and review notes."""
    # Resolution order:
    # 1. If the linker-reported object has its own gcno, emit it directly as
    #    `object:function`.
    # 2. Otherwise find leaf objects that define the same function name.
    # 3. If final-ELF DWARF identifies which same-name leaf object survived,
    #    choose the remaining candidate object as the removed one.
    # 4. Stage unambiguous removals first, then use those resolved leaf objects
    #    as same-origin hints for later prelink.o-style duplicate names.
    # 5. If resolution is still not unique, emit a `# REVIEW ...` block or fail
    #    in strict mode.
    #
    resolver = RemovalResolver(removed_entries, strict, dwarf_state)
    state = ResolutionOutput(
        [],
        [],
        [],
        set(),
        defaultdict(set),
    )
    pending_entries = list(removed_entries)

    while pending_entries:
        next_pending, made_progress = advance_pending_entries(
            resolver,
            pending_entries,
            state,
        )

        if not made_progress:
            finish_pending_entries(
                resolver,
                next_pending,
                state,
            )
            break

        pending_entries = next_pending

    if strict and state.warnings:
        raise RuntimeError(
            "strict object matching failed:\n" + "\n".join(state.warnings)
        )
    return state.resolved_lines, state.warnings, state.review_lines


def merge_config_lines(
    function_lines: List[str],
    whole_object_lines: List[str],
) -> List[str]:
    """Merge active config lines and let `object:*` override object:function."""
    merged = function_lines + whole_object_lines
    whole_objects = {
        obj_path
        for function, obj_path in (parse_object_scoped_entry(line) for line in merged)
        if function == "*"
    }

    lines: List[str] = []
    seen: Set[str] = set()
    for line in merged:
        function, obj_path = parse_object_scoped_entry(line)
        if function != "*" and obj_path in whole_objects:
            continue
        if line not in seen:
            seen.add(line)
            lines.append(line)
    return lines


def clean_name(name: str) -> str:
    """Drop linker/readelf punctuation that is not part of the symbol identity."""
    name = name.rstrip(".,")
    return re.sub(r"/\d+$", "", name)


def normalize_name(name: str) -> str:
    """Normalize a name so linker, DWARF, and gcov forms line up."""
    name = clean_name(name)
    while True:
        clone_match = CLONE_RE.match(name)
        if not clone_match:
            return name
        name = clone_match.group("base")


def parse_object_scoped_entry(line: str) -> FuncKey:
    """Parse one `object:function` config line into `(function, object)`."""
    obj_path, function = line.rsplit(":", 1)
    if not obj_path or not function:
        raise RuntimeError(f"invalid object-scoped entry: {line}")
    return function, normalize_object_path(obj_path)


def iter_readelf(readelf: str, path: str) -> Iterable[str]:
    """Stream `readelf --debug-dump=info --wide` output for one path."""
    args = [readelf, "--debug-dump=info", "--wide", path]
    try:
        with subprocess.Popen(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
        ) as proc:
            assert proc.stdout is not None
            for line in proc.stdout:
                yield line.rstrip("\n")
            stderr = proc.stderr.read() if proc.stderr else ""
            returncode = proc.wait()
    except FileNotFoundError as exc:
        raise RuntimeError("readelf not found") from exc
    if returncode != 0:
        raise RuntimeError(f"readelf failed: {' '.join(args)}\n{stderr}")


def clean_dwarf_value(value: str) -> str:
    """Strip readelf formatting wrappers from one attribute value."""
    value = value.strip()
    if "):" in value:
        value = value.split("):")[-1].strip()
    return value


class DwarfScanner:
    """
    Small stateful DWARF scanner.

    The class keeps the current DIE table in one place so the inline-only
    inference reads more like a straight parser than a collection of generic
    helper calls.
    """

    def __init__(self, readelf: str):
        self.readelf = readelf
        self.die_by_offset: DieMap = {}
        self.assembly_defined_names: Set[str] = set()

    def object_hint(self, die: Die) -> Optional[str]:
        """
        Resolve the leaf object that should own the gcno for one DIE.
        """
        if die.dwarf_object and matching_gcno_path(die.dwarf_object):
            return normalize_object_path(die.dwarf_object)

        if die.cu_offset is None:
            return None
        cu_die = self.die_by_offset.get(die.cu_offset)
        if not cu_die:
            return None
        if not cu_die.cu_name:
            return None
        return object_from_source_path(
            cu_die.cu_name,
            cu_die.cu_comp_dir,
        )

    def resolve_identity(
        self,
        offset: int,
        visited: Optional[Set[int]] = None,
    ) -> Optional[FuncKey]:
        """
        Resolve both the function name and any object hint for one DIE.
        """
        if visited is None:
            visited = set()
        if offset in visited:
            return None
        visited.add(offset)

        die = self.die_by_offset.get(offset)
        if not die:
            return None

        name = die.name or die.linkage_name
        if name:
            return normalize_name(name), self.object_hint(die)

        if die.declaration is not None:
            resolved = self.resolve_identity(die.declaration, visited)
            if resolved:
                return resolved

        if die.origin is not None:
            return self.resolve_identity(die.origin, visited)
        return None

    def scan_one(self, path: str) -> Tuple[Dict[FuncKey, Set[FuncKey]], Set[FuncKey]]:
        """
        Scan one DWARF input file and return inline relationships plus functions
        that still look defined out-of-line.
        """
        self.parse_path(path)
        return self.collect_results()

    def parse_path(self, path: str) -> None:
        """Parse one DWARF file into the current DIE table."""
        self.die_by_offset = {}
        stack: List[int] = []
        current_offset: Optional[int] = None
        current_cu_offset: Optional[int] = None
        dwarf_object_hint = normalize_object_path(path) if path.endswith(".o") else None

        for line in iter_readelf(self.readelf, path):
            header = DIE_RE.match(line)
            if header:
                current_offset, current_cu_offset = self.start_die(
                    header, stack, current_cu_offset, dwarf_object_hint
                )
                continue

            if current_offset is None:
                continue

            self.parse_attr_line(current_offset, line)

    def start_die(
        self,
        header: re.Match[str],
        stack: List[int],
        current_cu_offset: Optional[int],
        dwarf_object_hint: Optional[str],
    ) -> Tuple[int, Optional[int]]:
        """Create one DIE from a readelf header line."""
        depth = int(header.group("depth"))
        offset = int(header.group("offset"), 16)
        tag = header.group("tag")

        while len(stack) > depth:
            stack.pop()

        parent = stack[-1] if stack else None
        if tag == "DW_TAG_compile_unit":
            current_cu_offset = offset

        self.die_by_offset[offset] = Die(
            tag=tag,
            parent=parent,
            cu_offset=current_cu_offset,
            dwarf_object=dwarf_object_hint,
        )
        stack.append(offset)
        return offset, current_cu_offset

    def collect_results(self) -> Tuple[Dict[FuncKey, Set[FuncKey]], Set[FuncKey]]:
        """Summarize the parsed DIE table as inline edges plus defined functions."""
        inlined_callers: Dict[FuncKey, Set[FuncKey]] = defaultdict(set)
        defined: Set[FuncKey] = set()
        for offset, die in self.die_by_offset.items():
            self.collect_defined(offset, die, defined)
            self.collect_inline_callers(die, inlined_callers)
        return inlined_callers, defined

    def collect_defined(
        self,
        offset: int,
        die: Die,
        defined: Set[FuncKey],
    ) -> None:
        """Record one function as defined when it still has code."""
        if die.tag != "DW_TAG_subprogram" or not die.has_code:
            return
        identity = self.resolve_identity(offset)
        if identity:
            defined.add(identity)
            if self.is_assembly_die(die):
                self.assembly_defined_names.add(identity[0])

    def collect_inline_callers(
        self,
        die: Die,
        inlined_callers: Dict[FuncKey, Set[FuncKey]],
    ) -> None:
        """Record one `inlined callee -> caller` relationship."""
        if die.tag != "DW_TAG_inlined_subroutine":
            return
        callee = self.resolve_inline_callee(die)
        caller = self.resolve_inlined_subroutine_caller(die)
        if callee and caller:
            inlined_callers[callee].add(caller)

    def parse_attr_line(self, current_offset: int, line: str) -> None:
        """
        Update one DIE from one readelf attribute line.
        """
        die = self.die_by_offset[current_offset]
        match = DWARF_LOW_PC_RE.search(line)
        if match:
            value = clean_dwarf_value(match.group("value"))
            try:
                low_pc = int(value, 0)
            except ValueError:
                low_pc = None

            # Final linked DWARF can keep dead functions with `DW_AT_low_pc: 0`.
            # That should not count as a surviving out-of-line body.
            if die.dwarf_object is None and low_pc == 0:
                return

            die.has_code = True
        elif DWARF_RANGES_RE.search(line):
            die.has_code = True
        else:
            match = DWARF_NAME_RE.search(line)
            if match:
                self.handle_attr_name(
                    current_offset,
                    clean_dwarf_value(match.group("value")),
                )
                return

            match = DWARF_COMP_DIR_RE.search(line)
            if match:
                die.cu_comp_dir = clean_dwarf_value(match.group("value"))
                return

            match = DWARF_LANGUAGE_RE.search(line)
            if match:
                die.cu_language = clean_dwarf_value(match.group("value"))
                return

            match = DWARF_LINKAGE_RE.search(line)
            if match:
                die.linkage_name = clean_dwarf_value(match.group("value"))
                return

            match = DWARF_ABSTRACT_ORIGIN_RE.search(line)
            if match:
                die.origin = int(match.group("offset"), 16)
                return

            match = DWARF_SPECIFICATION_RE.search(line)
            if match:
                die.declaration = int(match.group("offset"), 16)

    def handle_attr_name(self, current_offset: int, value: str) -> None:
        """Record one DW_AT_name value on the current DIE."""
        die = self.die_by_offset[current_offset]
        die.name = value

        if die.tag == "DW_TAG_compile_unit":
            die.cu_name = value
            die.cu_offset = current_offset

    def resolve_inline_callee(self, die: Die) -> Optional[FuncKey]:
        """
        Resolve the callee identity for one `DW_TAG_inlined_subroutine` DIE.
        """
        if die.origin is None:
            return None
        return self.resolve_identity(die.origin)

    def resolve_inlined_subroutine_caller(
        self,
        die: Die,
    ) -> Optional[FuncKey]:
        """
        Follow parent DIEs until the enclosing caller function is found.
        """
        parent = die.parent
        while parent is not None:
            parent_die = self.die_by_offset.get(parent)
            if not parent_die:
                return None

            # An inlined-subroutine DIE is often nested inside lexical blocks,
            # try/catch regions, or other scope/container DIEs rather than
            # directly under the caller function DIE, so keep walking upward
            # until the first enclosing function is found.
            if parent_die.tag == "DW_TAG_subprogram":
                return self.resolve_identity(parent)
            parent = parent_die.parent
        return None

    def is_assembly_die(self, die: Die) -> bool:
        """Return true when one DIE belongs to an assembler compile unit."""
        if die.cu_offset is None:
            return False

        cu_die = self.die_by_offset.get(die.cu_offset)
        if not cu_die:
            return False

        if cu_die.cu_language and "assembler" in cu_die.cu_language.lower():
            return True

        if cu_die.cu_name and cu_die.cu_name.endswith((".S", ".s")):
            return True

        return False


def parse_dwarf_data(
    paths: Iterable[str],
    readelf: str,
) -> DwarfParseResult:
    """
    Scan DWARF inputs and collect inline-callee relationships plus subprograms
    that still appear to own concrete code ranges.

    Returns four pieces of state:
    - `inline callee -> callers`
    - all functions that still look defined out-of-line
    - functions defined in non-`.o` DWARF inputs, used as the final-ELF
      "surviving function" view during object resolution
    - function names whose DWARF provenance comes from assembler compile units
    """
    scanner = DwarfScanner(readelf)
    inlined_callers: Dict[FuncKey, Set[FuncKey]] = defaultdict(set)
    defined: Set[FuncKey] = set()
    final_defined: Set[FuncKey] = set()
    for path in paths:
        file_inlined, file_defined = scanner.scan_one(path)
        defined.update(file_defined)
        if not path.endswith(".o"):
            final_defined.update(file_defined)

        for callee, callers in file_inlined.items():
            inlined_callers[callee].update(callers)
    return DwarfParseResult(
        inlined_callers,
        defined,
        final_defined,
        scanner.assembly_defined_names,
    )


def find_inline_only_functions(
    remove_functions: Set[FuncKey],
    inline_info: Dict[FuncKey, Set[FuncKey]],
    defined_functions: Set[FuncKey],
) -> Set[FuncKey]:
    """
    Infer extra scoped removals for callees that survive only as inlined DWARF
    entries and whose every caller is already known to be discarded.
    """
    extra: Set[FuncKey] = set()
    for callee, callers in inline_info.items():
        if not callers or callee in remove_functions:
            continue

        # Only auto-remove DWARF candidates when both the callee and its caller
        # set can be tied to concrete leaf objects. Otherwise the inference is
        # informational but not safe enough to rewrite gcno files.
        if callee[1] is None or any(caller[1] is None for caller in callers):
            continue

        if callee in defined_functions:
            continue

        if callers.issubset(remove_functions):
            extra.add(callee)
    return extra


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Extract removed function names from ld --print-gc-sections output."
    )
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="Do not echo input lines to stderr.",
    )
    parser.add_argument(
        "-o",
        "--output",
        help="Write function list to this file instead of stdout.",
    )
    parser.add_argument(
        "--strict-object-match",
        action="store_true",
        help=(
            "Fail if a discarded function cannot be resolved to a single leaf "
            "object file. Ambiguous or unresolved entries become review "
            "comments without this flag."
        ),
    )
    parser.add_argument(
        "--dwarf",
        action="append",
        default=[],
        help=(
            "Path to a binary/object file with DWARF info; may be repeated. "
            "Inline-only functions are added when all their callers "
            "are removed."
        ),
    )
    parser.add_argument(
        "--readelf",
        default="readelf",
        help="Readelf binary to use for DWARF parsing. Default: readelf",
    )
    parser.add_argument(
        "--linker-map",
        help="Path to a linker map file used to find unlinked archive members.",
    )
    return parser.parse_args()


def resolve_inline_only_removals(
    args: argparse.Namespace,
    resolved_config_lines: List[str],
    inlined: Dict[FuncKey, Set[FuncKey]],
    defined: Set[FuncKey],
) -> Tuple[List[str], List[str], List[str]]:
    """
    Infer inline-only removals from DWARF and pass them through the normal
    object-resolution path before they become active `object:function` lines.
    """
    if not inlined and not defined:
        return [], [], []

    resolved_removals = {
        parse_object_scoped_entry(line) for line in resolved_config_lines
    }
    inline_only_entries = sorted(
        find_inline_only_functions(resolved_removals, inlined, defined)
    )
    return resolve_removed_entries(
        [RemovalEntry(name, obj_path, name) for name, obj_path in inline_only_entries],
        args.strict_object_match,
    )


def write_output(
    output_path: Optional[str],
    functions: List[str],
    inline_only: List[str],
    review_lines: List[str],
) -> None:
    """Write or print the generated config lines."""
    if output_path:
        handle = open(  # pylint: disable=consider-using-with
            output_path,
            "w",
            encoding="utf-8",
        )
    else:
        handle = sys.stdout

    try:
        for name in functions:
            handle.write(f"{name}\n")
        if inline_only:
            handle.write("\n# Detected inline functions by DWARF scanning\n")
            for name in inline_only:
                handle.write(f"{name}\n")
        if review_lines:
            handle.write("\n")
            for line in review_lines:
                handle.write(f"{line}\n")
    finally:
        if output_path:
            handle.close()


def main() -> int:
    """Glue linker parsing, DWARF inference, and config output together."""
    args = parse_args()

    try:
        dwarf_data = DwarfParseResult(defaultdict(set), set(), set(), set())
        if args.dwarf:
            dwarf_data = parse_dwarf_data(
                args.dwarf,
                args.readelf,
            )

        removed_entries = extract_functions(sys.stdin, not args.quiet)
        resolved_config_lines, warnings, review_lines = resolve_removed_entries(
            removed_entries,
            args.strict_object_match,
            DwarfResolutionState(
                dwarf_data.final_defined_functions,
                dwarf_data.assembly_defined_names,
            ),
        )
        whole_object_lines: List[str] = []
        if args.linker_map:
            whole_object_lines, map_warnings = resolve_linker_map_gcno_removals(
                os.getcwd(),
                args.linker_map,
            )
            warnings.extend(map_warnings)
        resolved_config_lines = merge_config_lines(
            resolved_config_lines,
            whole_object_lines,
        )
        for warning in warnings:
            print(f"warning: {warning}", file=sys.stderr)

        inline_only, inline_warnings, inline_review_lines = resolve_inline_only_removals(
            args,
            resolved_config_lines,
            dwarf_data.inlined_callers,
            dwarf_data.defined_functions,
        )
        for warning in inline_warnings:
            print(f"warning: {warning}", file=sys.stderr)
        review_lines.extend(inline_review_lines)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    write_output(args.output, resolved_config_lines, inline_only, review_lines)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
